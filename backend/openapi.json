{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "The inner error object.",
        "properties": {
          "code": {
            "description": "Stable machine-readable code, e.g. not_found or approval_required.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Structured extra information.",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Human-readable explanation, safe to show.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx response body.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "description": "Probe result.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Manceps API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Report that the process is serving requests; never touches the database.\n\nReturns:\n    {\"status\": \"ok\"}.",
        "operationId": "health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "meta"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Report readiness: the database answers a ping and the platform indexes exist.\n\nArgs:\n    request: Incoming request.\n\nReturns:\n    {\"status\": \"ok\"}.\n\nRaises:\n    ApiError: 503 database_unavailable when the database is unreachable or indexes are missing.",
        "operationId": "readiness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Client error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Database unavailable"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
