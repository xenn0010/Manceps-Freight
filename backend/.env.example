# Manceps API and worker: local development template. No real secrets belong in this file.
#
# Settings are read only from the process environment (dotenv files are never loaded), so export them:
#   cp .env.example .env            # .env is git-ignored
#   set -a; source .env; set +a
# Then export the signing keys from scripts/gen_keys.py (see docs/api/frontend-guide.md, "Run it locally").

ENV=dev
LOG_LEVEL=INFO

# Local MongoDB: a single-node replica set forwarded from the Lima VM.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
# The hermes-freight signup worker always reads the "platform" database; keep this value if you want firms provisioned.
PLATFORM_DB=platform

API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Dev-only phone sign-in: exactly 6 digits, accepted for every phone, no SMS is sent.
# Refused at startup unless ENV=dev. Ignored when the three TWILIO_* values below are set (Twilio wins).
DEV_OTP_CODE=000000

# Signing keys: generated by `uv run python scripts/gen_keys.py`, exported from its JSON output, never pasted here.
# JWT_ACTIVE_KID=
# JWT_KEYS_JSON=
# SECRETS_KEY=

# Optional integrations. Leave unset locally; each feature answers 503 not_configured without them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# EMAIL_LOGIN_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# FMCSA_WEBKEY=
# EIA_API_KEY=
# GOOGLE_MAPS_API_KEY=
# ORS_API_KEY=
# EXPORT_DIR=
